# 后端配置示例 —— 复制为 .env 后按需修改
# Copy-Item .env.example .env

# SQLite 数据库文件路径（相对于 backend/ 目录）
DATABASE_URL=sqlite:///./fault_tracker.db

# 服务监听
HOST=127.0.0.1
PORT=8000

# CORS 白名单（逗号分隔）；前端 Vite 默认端口 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLAlchemy echo（开发期打开可看到每条 SQL；生产关闭）
DB_ECHO=false

# JWT 签名密钥（生产必改；丢失或泄漏等同所有已发 token 立即失效）
SECRET_KEY=please-change-me-to-a-32-byte-random-string

# Token 过期时间（分钟），默认 720 = 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720

# seed.py 演示账号的统一初始密码（≥6 位，仅当库中缺账号时需要；不写死在代码里）
# SEED_PASSWORD=change-me-demo-password
