# ---- Python 字节码 / 打包产物 ----
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# ---- Python 虚拟环境（体积大、与本机绑定，绝不提交）----
backend/.venv/
.venv/
venv/
env/

# ---- uv 产物（后端用 pip + requirements.txt + .venv 管理，本项目不使用 uv）----
# 根目录 pyproject.toml / uv.lock 系 uv init 生成（dependencies 为空，与后端实际依赖脱节）；
# 经用户确认加入忽略，避免误提交。若日后改用 uv 管理后端，删除本节即可恢复跟踪。
/pyproject.toml
/uv.lock

# ---- SQLite 运行时数据库文件（属"运行结果"，不纳入版本管理）----
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/data/*.db

# ---- 本地环境变量（含端口、DB 路径等本机配置，只提交 .env.example）----
.env
.env.local
backend/.env
frontend/.env
frontend/.env.local

# ---- Node / 前端产物 ----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 编辑器 / IDE 配置 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 操作系统杂项 ----
Thumbs.db
.DS_Store

# ---- 临时/调试脚本（本地保留，不提交）----
_tmp/
*.log
