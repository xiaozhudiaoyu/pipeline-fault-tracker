<?xml version="1.0" encoding="UTF-8"?>
<!--
  「语法与 OOP」+「Bean Validation」练习工程——极简、纯 Java 8，不引 Spring。
  依赖全部对齐本机 TPM 项目基座（Spring Boot 2.7.18 所带的版本线），但此处只用到：
    · jackson-databind 2.13.5 —— 验证枚举序列化（@JsonValue）
    · lombok 1.18.30          —— Java 8 无 record，用 Lombok 生成 getter/toString
    · junit-jupiter 5.9.3     —— 单元测试（Boot 2.7 测试栈同款）
    · hibernate-validator 6.2.5 —— Bean Validation（javax.validation 命名空间，对齐 Boot 2.7）
    · jakarta.el 3.0.4        —— EL 表达式引擎（校验消息插值必需）
  命令行 mvn 未上 PATH，请用 IntelliJ 自带 Maven 打开本目录运行。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>fault-oop-practice</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>fault-oop-practice</name>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.13.5</jackson.version>
        <lombok.version>1.18.30</lombok.version>
        <junit.version>5.9.3</junit.version>
    </properties>

    <dependencies>
        <!-- 枚举 JSON 序列化：断言 FaultStatus.PENDING -> "pending" -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Lombok：Java 8 下替代 record，编译期生成样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5（aggregate 包已含 engine） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Bean Validation 实现（javax.validation 命名空间，对齐 Boot 2.7） -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>6.2.5.Final</version>
        </dependency>

        <!-- EL 表达式引擎（Hibernate Validator 校验消息插值需要） -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.el</artifactId>
            <version>3.0.4</version>
        </dependency>

        <!-- ===== 第二层：Spring Boot ===== -->
        <!-- Web：内嵌 Tomcat + Spring MVC + Jackson（路由/JSON） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>2.7.18</version>
        </dependency>

        <!-- Validation：把 Hibernate Validator 自动接入 @Valid @RequestBody -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <version>2.7.18</version>
        </dependency>

        <!-- Test：MockMvc + Spring TestContext（不用真起服务器就能测 HTTP） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>2.7.18</version>
            <scope>test</scope>
        </dependency>

        <!-- ===== 第三层：JPA / Hibernate ===== -->
        <!-- Data JPA：Hibernate 5.6 + Spring Data（JpaRepository 自动生成 CRUD） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>2.7.18</version>
        </dependency>

        <!-- H2 内存数据库：不用装任何东西，启动即用，测试专用 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.1.214</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway：数据库迁移（对照 Alembic）——只向前、不回滚 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>8.5.13</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 编译插件：锁定 Java 8，并把 Lombok 注册为注解处理器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Surefire：JUnit 5 需要 2.22+，这里用 3.1.2 明确支持 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>
</project>
