# 后端配置示例 —— 复制为 .env 后按需修改
# Copy-Item .env.example .env

# SQLite 数据库文件路径（相对于 backend/ 目录）
DATABASE_URL=sqlite:///./demo_app.db

# 服务监听
HOST=127.0.0.1
PORT=8000

# CORS 白名单（逗号分隔）；前端 Vite 默认端口 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLAlchemy echo（开发期打开可看到每条 SQL；生产关闭）
DB_ECHO=false
